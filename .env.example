# Spring Boot 백엔드 base URL (HTTPS, 끝에 슬래시 없이)
# 로컬에 .env 로 복사해 쓴다 (.env 는 gitignore). 아래는 확정된 dev 도메인.
#   cp .env.example .env
# api-schema.md 의 엔드포인트가 /api/... 이므로 baseURL 에는 슬래시를 붙이지 않는다.
EXPO_PUBLIC_API_BASE_URL=https://when2go.qzz.io

# 네이버 클라우드 플랫폼 Maps — Mobile Dynamic Map 클라이언트 ID (NCP Key ID)
# https://console.ncloud.com → AI·NAVER API → Maps → Application 등록 후 발급
# iOS 번들 ID `kr.co.when2go.app` / Android 패키지명 `kr.co.when2go.app` 을 NCP 콘솔에 등록해야 인증 통과
# 본 키는 Mobile Dynamic Map SDK 호출(무제한 무료) 한정 사용.
# Geocoding/Reverse Geocoding/Static Map/Directions 등 부가 API 호출 금지(과금).
EXPO_PUBLIC_NAVER_MAP_NCP_KEY_ID=여기에_NCP_KEY_ID_입력

# 베타 테스터 Apple ID 이메일 (TestFlight 내부 테스터 등록 시 사용).
# PII이므로 docs/DEPLOY.md 에 직접 적지 말 것. 실제 값은 .env 에만(gitignore).
# EXPO_PUBLIC_ 접두 금지 — 앱 번들에 들어가면 안 되는 인적 참조값.
WHEN2GO_TESTER_APPLE_EMAIL=tester@example.com
