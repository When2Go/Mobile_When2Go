# Spring Boot 백엔드 base URL (HTTPS, 끝에 슬래시 없이)
# 로컬에 .env 로 복사해 쓴다 (.env 는 gitignore). 아래는 확정된 dev 도메인.
#   cp .env.example .env
# api-schema.md 의 엔드포인트가 /api/... 이므로 baseURL 에는 슬래시를 붙이지 않는다.
EXPO_PUBLIC_API_BASE_URL=https://when2go.qzz.io

# Kakao REST API 키 — 카카오 개발자 콘솔 > 앱 > 앱 키 > REST API 키.
# 네이티브 앱 키(EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY)와 다른 키이므로 혼동 주의.
# 키 미설정 시 앱 시작 시점에 오류가 발생합니다.
EXPO_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 베타 테스터 Apple ID 이메일 (TestFlight 내부 테스터 등록 시 사용).
# PII이므로 docs/DEPLOY.md 에 직접 적지 말 것. 실제 값은 .env 에만(gitignore).
# EXPO_PUBLIC_ 접두 금지 — 앱 번들에 들어가면 안 되는 인적 참조값.
WHEN2GO_TESTER_APPLE_EMAIL=tester@example.com
